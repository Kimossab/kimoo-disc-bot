{
  "name": "kimoo-disc-bot",
  "version": "2.19.0",
  "description": "Kimossab's Discord Bot",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "dev": "tsx watch --inspect ./src/bot.ts",
    "prod": "node ./build/bot.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type:check": "tsc --noEmit --skipLibCheck",
    "type:check:watch": "tsc --noEmit --skipLibCheck -w",
    "migrate:prod": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev"
  },
  "author": "Kimossab",
  "license": "ISC",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.11.0",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "discord-api-types": "^0.37.103",
    "eslint": "^9.16.0",
    "eslint-plugin-import-newlines": "^1.4.0",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "lint-staged": "^15.2.10",
    "prisma": "^5.7.1",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "axios": "^1.7.7",
    "dotenv": "^16.3.1",
    "form-data": "^4.0.0",
    "tsx": "^4.20.5",
    "winston": "^3.10.0",
    "winston-loki": "^6.0.6",
    "ws": "^8.17.1"
  }
}
